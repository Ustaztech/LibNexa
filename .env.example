PORT=5000
NODE_ENV=production
# For MySQL production:
# DATABASE_URL="mysql://libnexa_user:StrongPassword2026!@localhost:3306/libnexa_db"
# For zero-dependency SQLite development:
DATABASE_URL="file:./dev.db"

JWT_SECRET="replace-with-ultra-secure-random-string-in-production"
JWT_REFRESH_SECRET="replace-with-another-ultra-secure-random-string"
APP_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:5000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@nsuk.edu.ng
SMTP_PASSWORD=your_smtp_password
MAIL_FROM="noreply-library@nsuk.edu.ng"

FIREBASE_PROJECT_ID=libnexa-fcm
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@libnexa-fcm.iam.gserviceaccount.com
